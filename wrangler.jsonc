{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Replace with the id printed by `npx wrangler d1 create planner`.
      "database_id": "72bdc5b9-4ad1-4ff3-813e-19bdf5ceee7f",
      "database_name": "planner",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "VAPID_SUBJECT": "mailto:lucascandradex1@gmail.com",
    // Personal instance: only one vault (your devices). "0" = unlimited.
    "MAX_VAULTS": "1"
  },
  "observability": {
    "enabled": true
  }
}
